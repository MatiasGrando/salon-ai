<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Luxe Nails Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0e0d0c;
    --ink-soft:#1a1816;
    --cream:#f4ece6;
    --cream-2:#efe3db;
    --rose:#c98a9a;
    --rose-deep:#b56d80;
    --rose-pale:#e7c9d0;
    --text-soft:#c9bdb6;
    --gold:#cbaa77;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{
    font-family:'Jost', sans-serif;
    color:var(--ink);
    background:var(--cream);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.serif{font-family:'Cormorant Garamond','Garamond','Georgia',serif; font-weight:500;}
  .eyebrow{
    font-size:12px; letter-spacing:.2em; text-transform:uppercase; color:var(--rose-deep); font-weight:500;
  }
  .eyebrow.on-dark{color:var(--rose-pale);}
  a{color:inherit; text-decoration:none;}
  .wrap{max-width:1280px; margin:0 auto; padding:0 60px;}
  img.ph{width:100%; height:100%; object-fit:cover; display:block;}

  /* ---------- placeholder art panels (stand-in for photography) ---------- */
  .art{
    position:relative; overflow:hidden; border-radius:2px;
    background:#e8dcd4;
  }
  .art img{width:100%; height:100%; object-fit:cover; display:block;}

  /* ---------- top bar ---------- */
  .topbar{
    background:var(--rose-deep); color:#fff; font-size:11px; letter-spacing:.12em;
    display:flex; justify-content:space-between; align-items:center;
    padding:9px 60px;
  }
  .topbar span:last-child{opacity:.85;}

  /* ---------- header ---------- */
  header{
    position:absolute; top:0; left:0; right:0; z-index:5;
    background:transparent; color:#fff;
    display:flex; align-items:center; justify-content:space-between;
    padding:26px 60px;
  }
  .logo{line-height:1.05;}
  .logo .big{font-family:'Cormorant Garamond','Garamond','Georgia',serif; font-size:24px; letter-spacing:.08em;}
  .logo .small{font-size:9px; letter-spacing:.28em; color:var(--text-soft); display:block; margin-top:2px;}
  nav{display:flex; gap:38px; font-size:12px; letter-spacing:.14em;}
  nav a{opacity:.85; transition:opacity .2s;}
  nav a:hover{opacity:1; color:var(--rose-pale);}
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    border:1px solid currentColor; padding:12px 26px; font-size:11px; letter-spacing:.16em;
    border-radius:30px; cursor:pointer; background:none; transition:.25s;
  }
  .btn-outline-light{color:#fff;}
  .btn-outline-light:hover{background:#fff; color:var(--ink);}
  .btn-rose{background:var(--rose); color:#fff; border:1px solid var(--rose);}
  .btn-rose:hover{background:var(--rose-deep); border-color:var(--rose-deep);}
  .btn-dark{background:var(--ink); color:#fff; border:1px solid var(--ink);}
  .btn-dark:hover{background:var(--ink-soft);}

  /* ---------- hero ---------- */
  .hero{
    background:var(--ink); color:#fff; position:relative; overflow:hidden;
    min-height:760px; display:flex; align-items:stretch;
  }
  .hero-bg{position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:76% 8%;}
  .hero-scrim{
    position:absolute; inset:0;
    background:linear-gradient(100deg, rgba(10,9,8,.94) 0%, rgba(10,9,8,.82) 32%, rgba(10,9,8,.35) 55%, rgba(10,9,8,0) 72%),
               linear-gradient(180deg, rgba(10,9,8,.65) 0%, rgba(10,9,8,0) 22%);
  }
  .hero-copy{
    position:relative; z-index:2; padding:150px 60px 60px 60px; display:flex; flex-direction:column;
    justify-content:center; max-width:620px;
  }
  .hero-copy .eyebrow{margin-bottom:22px;}
  .hero-copy h1{font-size:76px; line-height:.98; letter-spacing:.01em;}
  .hero-copy h1 .rose{color:var(--rose);}
  .hero-copy p{
    font-size:15px; color:var(--text-soft); max-width:360px; margin:26px 0 34px; line-height:1.6;
  }
  .scroll-note{
    display:flex; align-items:center; gap:10px; font-size:11px; letter-spacing:.14em;
    color:var(--text-soft); margin-top:56px;
  }
  .scroll-note .dot{width:26px; height:26px; border:1px solid var(--text-soft); border-radius:50%; display:flex; align-items:center; justify-content:center;}
  .hero-badge{
    position:absolute; z-index:3; right:36px; top:44%; width:96px; height:96px; border-radius:50%;
    background:rgba(28,22,19,.55); backdrop-filter:blur(2px);
    border:1px solid rgba(255,255,255,.35);
    display:flex; align-items:center; justify-content:center; color:#fff;
  }
  .hero-badge .play{
    width:34px; height:34px; border-radius:50%; background:var(--rose);
    display:flex; align-items:center; justify-content:center;
  }
  .hero-badge svg.ring{position:absolute; inset:0; width:100%; height:100%; animation:spin 14s linear infinite;}
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---------- features bar ---------- */
  .features{background:var(--ink); border-top:1px solid rgba(255,255,255,.08);}
  .features .wrap{
    display:grid; grid-template-columns:repeat(4,1fr); padding:38px 60px; gap:20px;
  }
  .feature{display:flex; flex-direction:column; align-items:center; gap:12px; color:#fff; text-align:center;}
  .feature svg{width:26px; height:26px; stroke:var(--rose-pale);}
  .feature span{font-size:11px; letter-spacing:.14em; color:var(--text-soft);}

  /* ---------- experience section ---------- */
  .experience{background:var(--cream); padding:100px 0;}
  .experience .wrap{display:grid; grid-template-columns:.85fr 1.4fr; gap:70px; align-items:center;}
  .experience h2{font-size:42px; line-height:1.15; margin:14px 0 20px;}
  .experience h2 .rose{color:var(--rose-deep); font-style:italic;}
  .experience p{font-size:14px; color:#6b5f5a; line-height:1.7; max-width:340px; margin-bottom:30px;}
  .btn-line{
    display:inline-flex; align-items:center; gap:8px; font-size:11px; letter-spacing:.16em;
    border-bottom:1px solid var(--ink); padding-bottom:6px;
  }
  .exp-gallery{position:relative;}
  .exp-images{display:grid; grid-template-columns:1fr 1fr 1.15fr; gap:14px; height:340px;}
  .exp-arrows{position:absolute; top:-58px; right:0; display:flex; gap:10px;}
  .arrow{
    width:34px; height:34px; border-radius:50%; border:1px solid var(--ink);
    display:flex; align-items:center; justify-content:center; cursor:pointer;
  }
  .arrow.filled{background:var(--ink); color:#fff;}

  /* ---------- services section ---------- */
  .services{background:var(--ink); color:#fff; padding:100px 0;}
  .services .top{display:grid; grid-template-columns:.8fr 1.6fr; gap:60px; margin-bottom:50px; align-items:end;}
  .services h2{font-size:42px; line-height:1.1;}
  .services .top p{color:var(--text-soft); font-size:14px; max-width:280px; margin:16px 0 26px; line-height:1.6;}
  .service-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:22px;}
  .service-card{background:var(--ink-soft); border-radius:4px; overflow:hidden;}
  .service-card .art{height:190px;}
  .service-card .body{padding:20px 20px 24px;}
  .service-card .icon{
    width:34px; height:34px; border-radius:50%; background:rgba(201,138,154,.18);
    display:flex; align-items:center; justify-content:center; margin-top:-38px; margin-bottom:14px;
    border:1px solid rgba(255,255,255,.15); position:relative; z-index:2;
  }
  .service-card .icon svg{width:15px; height:15px; stroke:var(--rose-pale);}
  .service-card h3{font-family:'Jost',sans-serif; font-weight:500; font-size:13px; letter-spacing:.06em; text-transform:uppercase; margin-bottom:8px;}
  .service-card p{font-size:12.5px; color:var(--text-soft); line-height:1.55; margin-bottom:16px; min-height:38px;}
  .service-card .price{font-size:12px; letter-spacing:.08em; color:var(--rose-pale);}

  /* ---------- booking section ---------- */
  .booking{background:var(--cream-2); padding:100px 0;}
  .booking .wrap{display:grid; grid-template-columns:1fr .85fr; gap:70px; align-items:center;}
  .booking h2{font-size:42px; line-height:1.15; margin:14px 0 34px;}
  .booking h2 .rose{color:var(--rose-deep); font-style:italic;}
  .steps{display:flex; gap:34px; margin-bottom:40px;}
  .step{max-width:170px;}
  .step .num{
    width:38px; height:38px; border-radius:50%; border:1px solid var(--ink); display:flex;
    align-items:center; justify-content:center; margin-bottom:14px;
  }
  .step .num svg{width:16px; height:16px;}
  .step h4{font-size:13px; font-weight:500; margin-bottom:6px;}
  .step p{font-size:12px; color:#6b5f5a; line-height:1.5;}
  .phone-mock{position:relative; display:flex; justify-content:center;}
  .phone-frame{
    width:250px; height:500px; background:var(--ink); border-radius:34px; padding:14px;
    box-shadow:0 30px 60px -20px rgba(0,0,0,.4);
  }
  .phone-screen{
    background:var(--cream); border-radius:22px; height:100%; padding:22px 18px; overflow:hidden;
  }
  .phone-screen .plogo{font-family:'Cormorant Garamond','Garamond','Georgia',serif; font-size:13px; text-align:center; letter-spacing:.1em; margin-bottom:2px;}
  .phone-screen .psmall{font-size:6px; text-align:center; letter-spacing:.2em; color:#8a7c76; margin-bottom:18px;}
  .phone-screen h5{font-size:14px; margin-bottom:14px;}
  .cal-grid{display:grid; grid-template-columns:repeat(7,1fr); gap:5px; margin-bottom:16px;}
  .cal-grid span{font-size:8px; text-align:center; color:#8a7c76; padding:4px 0;}
  .cal-grid .day{
    aspect-ratio:1; display:flex; align-items:center; justify-content:center; border-radius:50%; font-size:8px;
  }
  .cal-grid .day.active{background:var(--rose); color:#fff;}
  .phone-card{background:#fff; border-radius:10px; padding:12px; display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;}
  .phone-card .t{font-size:9px; font-weight:500;}
  .phone-card .s{font-size:7px; color:#8a7c76;}
  .online-badge{
    position:absolute; left:-10px; top:60px; width:78px; height:78px; border-radius:50%;
    background:var(--ink); color:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-size:9px; letter-spacing:.08em; box-shadow:0 10px 30px rgba(0,0,0,.25);
  }
  .online-badge b{font-size:15px; font-family:'Cormorant Garamond','Garamond','Georgia',serif;}

  /* ---------- gallery strip ---------- */
  .gallery{background:var(--cream); padding:90px 0 100px;}
  .gallery .top{display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:34px;}
  .gallery h2{font-size:36px;}
  .strip{display:grid; grid-template-columns:repeat(5,1fr); gap:14px; height:280px;}

  /* ---------- testimonial / stats ---------- */
  .testi{background:var(--ink); color:#fff; padding:70px 0;}
  .testi .wrap{display:grid; grid-template-columns:1fr auto; gap:40px; align-items:center;}
  .testi blockquote{
    font-family:'Cormorant Garamond','Garamond','Georgia',serif; font-size:26px; line-height:1.35; font-style:italic; max-width:480px;
  }
  .testi .quote-mark{font-size:40px; color:var(--rose); font-family:Georgia,serif; line-height:0; margin-bottom:10px; display:block;}
  .testi cite{display:block; font-style:normal; font-size:12px; color:var(--text-soft); margin-top:16px;}
  .stats{display:flex; gap:44px;}
  .stat{text-align:center;}
  .stat b{display:block; font-family:'Cormorant Garamond','Garamond','Georgia',serif; font-size:30px; color:var(--rose-pale);}
  .stat span{font-size:10px; letter-spacing:.1em; color:var(--text-soft);}

  /* ---------- footer ---------- */
  footer{background:var(--ink); color:#fff; border-top:1px solid rgba(255,255,255,.08); padding:34px 0;}
  footer .wrap{display:flex; justify-content:space-between; align-items:center;}
  .foot-nav{display:flex; gap:28px; font-size:11px; letter-spacing:.1em; color:var(--text-soft);}
  .foot-social{display:flex; gap:14px;}
  .foot-social a{
    width:32px; height:32px; border:1px solid rgba(255,255,255,.2); border-radius:50%;
    display:flex; align-items:center; justify-content:center;
  }
  .foot-bottom{
    text-align:center; font-size:10px; color:var(--text-soft); margin-top:22px; letter-spacing:.05em;
  }

  @media (max-width:980px){
    .wrap{padding:0 24px;}
    header, .topbar{padding-left:24px; padding-right:24px;}
    nav{display:none;}
    .hero{min-height:560px;}
    .hero-bg{object-position:70% center;}
    .hero-scrim{background:linear-gradient(180deg, rgba(10,9,8,.55) 0%, rgba(10,9,8,.88) 55%, rgba(10,9,8,.96) 100%);}
    .hero-copy{max-width:100%; padding:60px 24px 40px;}
    .hero-copy h1{font-size:52px;}
    .features .wrap{grid-template-columns:repeat(2,1fr);}
    .experience .wrap, .booking .wrap, .services .top{grid-template-columns:1fr;}
    .service-grid{grid-template-columns:repeat(2,1fr);}
    .strip{grid-template-columns:repeat(2,1fr); height:auto;}
    .strip .art{height:160px;}
    .testi .wrap{grid-template-columns:1fr;}
    .stats{flex-wrap:wrap; gap:26px;}
    footer .wrap{flex-direction:column; gap:16px;}
  }
</style>
</head>
