// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentOrigin {
  BOT
  WEB
  MANUAL
  UNKNOWN
}

enum ConversationStep {
  START
  ASK_SERVICE
  ASK_PROFESSIONAL
  ASK_DATE
  ASK_TIME
  ASK_CUSTOMER_NAME
  CONFIRM
  AWAITING_DEPOSIT
  COMPLETED
  CANCEL_SELECT_APPOINTMENT
  EDIT_SELECT_APPOINTMENT
  HUMAN_HANDOFF
}

enum ConversationOpportunityStatus {
  OPEN
  CONVERTED
  CLOSED
}

enum ServiceAttentionMode {
  DIRECT_BOOKING
  QUOTE
  ADVISOR
  GUIDED_ESTIMATE
}

enum ServiceDepositMode {
  NONE
  FIXED
  PERCENTAGE
}

enum BookingDepositStatus {
  PENDING_PROOF
  PROOF_RECEIVED
  APPROVED
  REJECTED
  EXPIRED
}

enum BookingDepositSource {
  WHATSAPP
  WEB
}

enum ServicePriceMode {
  FIXED
  STARTING_AT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ScheduleBlockReason {
  ABSENCE
  VACATION
  LATE_ARRIVAL
  SICK_LEAVE
  PERSONAL
  TRAINING
  MAINTENANCE
  HOLIDAY
  OTHER
}

enum WhatsAppConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  NEEDS_PAYMENT
  NEEDS_REVIEW
  ERROR
}

enum WhatsAppConnectionMode {
  CLIENT_OWNED
  INTERNAL_TEST
}

enum BillingOwner {
  CLIENT
  SALON_AI
}

enum ServiceCatalogDisplayMode {
  ALL_SERVICES
  CATEGORIES_FIRST
}

enum BookingFlowOrder {
  PROFESSIONAL_FIRST
  DATE_TIME_FIRST
}

enum ServiceCombinationPolicy {
  ALLOWED
  REVIEW_REQUIRED
  BLOCKED
}

enum ServiceVariantSelectionMode {
  ONE_OF
  MULTIPLE
}

enum UserRole {
  SUPER_ADMIN
  ACCOUNT_ADMIN
  BUSINESS_ADMIN
  STAFF
}

enum BusinessAccountStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  CANCELLED
}

enum BusinessDiscountType {
  PERCENTAGE
  FIXED
}

enum AccountChargeStatus {
  PENDING
  PAID
  BONIFIED
}

model BusinessPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  features    String[] @default([])
  price       Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  businesses Business[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id                     String                        @id @default(cuid())
  customerCode           String                        @unique
  name                   String
  isDemo                 Boolean                       @default(false)
  demoType               String?
  slug                   String?                       @unique
  logoUrl                String?
  landingEnabled         Boolean                       @default(true)
  landingTemplate        String                        @default("classic")
  landingSubtitle        String?
  landingFeature         String?
  landingOpeningYear     Int?
  landingDescription     String?
  landingTemplateContent Json?
  coverImageUrl          String?
  landingGalleryImages   String?
  publicWhatsapp         String?
  contactName            String?
  contactPhone           String?
  contactEmail           String?
  publicAddress          String?
  publicAddressArea      String?
  publicMapsUrl          String?
  instagramUrl           String?
  facebookUrl            String?
  tiktokUrl              String?
  botEnabled             Boolean                       @default(true)
  aiEnabled              Boolean                       @default(true)
  whatsappConfig         BusinessWhatsAppConfig?
  instagramConfig        BusinessInstagramConfig?
  featureSettings        BusinessFeatureSettings?
  botConfigurations      BusinessBotConfiguration[]
  paymentSettings        BusinessPaymentSettings?
  accountAdminId         String?
  accountAdmin           User?                         @relation("AccountAdminBusinesses", fields: [accountAdminId], references: [id], onDelete: SetNull)
  createdByUserId        String?
  createdByUser          User?                         @relation("CreatedBusinesses", fields: [createdByUserId], references: [id], onDelete: SetNull)
  planId                 String?
  plan                   BusinessPlan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  accountStatus          BusinessAccountStatus         @default(ONBOARDING)
  onboardingStatus       BusinessOnboardingStatus?
  billingSettings        BusinessBillingSettings?
  accountCharges         BusinessAccountCharge[]
  accountStatusChanges   BusinessAccountStatusChange[]

  professionals           Professional[]
  customers               Customer[]
  serviceCategories       ServiceCategory[]
  services                Service[]
  serviceCombinationRules ServiceCombinationRule[]
  businessHours           BusinessHours[]
  scheduleBlocks          ScheduleBlock[]
  conversations           Conversation[]
  instagramLeads          InstagramLead[]
  campaigns               Campaign[]
  whatsappTemplates       WhatsAppTemplate[]
  marketingPreferences    CustomerMarketingPreference[]
  campaignDeliveries      CampaignDelivery[]
  campaignRuns            CampaignRun[]
  campaignJobs            CampaignJob[]
  reminderAutomations     ReminderAutomation[]
  reminderDeliveries      ReminderDelivery[]
  postSaleAutomation      PostSaleAutomation?
  postSaleDeliveries      PostSaleDelivery[]
  communicationExecutions CommunicationExecution[]
  communicationRecipients CommunicationRecipient[]
  users                   User[]
  weexCustomerLinks       WeexCustomerLink[]
  bookingDeposits         BookingDeposit[]

  createdAt DateTime @default(now())

  @@index([accountAdminId])
  @@index([createdByUserId])
  @@index([planId])
  @@index([accountStatus])
  @@index([isDemo, createdByUserId])
}

model BusinessAccountStatusChange {
  id            String                @id @default(cuid())
  businessId    String
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromStatus    BusinessAccountStatus
  toStatus      BusinessAccountStatus
  reason        String?
  changedById   String
  changedByName String
  changedByRole UserRole
  createdAt     DateTime              @default(now())

  @@index([businessId, createdAt])
}

model BusinessBillingSettings {
  businessId     String                @id
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billingDay     Int                   @default(1)
  activatedAt    DateTime?
  nextBillingAt  DateTime?
  discountType   BusinessDiscountType?
  discountValue  Decimal?              @db.Decimal(12, 2)
  discountUntil  DateTime?
  discountReason String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([nextBillingAt])
}

model BusinessAccountCharge {
  id                  String              @id @default(cuid())
  businessId          String
  business            Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  period              String
  planName            String
  grossAmount         Decimal             @db.Decimal(12, 2)
  discountAmount      Decimal             @default(0) @db.Decimal(12, 2)
  netAmount           Decimal             @db.Decimal(12, 2)
  dueAt               DateTime
  originalDueAt       DateTime
  status              AccountChargeStatus @default(PENDING)
  paidAt              DateTime?
  paymentMethod       String?
  paymentReference    String?
  paymentNote         String?
  paymentRecordedBy   String?
  bonifiedAt          DateTime?
  bonificationReason  String?
  bonifiedBy          String?
  dueDateChangedBy    String?
  dueDateChangeReason String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([businessId, period])
  @@index([businessId, dueAt])
  @@index([status, dueAt])
}

model BusinessOnboardingStatus {
  businessId        String   @id
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountCreated    Boolean  @default(true)
  ownerLoggedIn     Boolean  @default(false)
  profileComplete   Boolean  @default(false)
  hasServices       Boolean  @default(false)
  hasProfessionals  Boolean  @default(false)
  hasBusinessHours  Boolean  @default(false)
  whatsappConnected Boolean  @default(false)
  landingConfigured Boolean  @default(false)
  completedSteps    Int      @default(1)
  totalSteps        Int      @default(8)
  progress          Int      @default(13)
  updatedAt         DateTime @updatedAt

  @@index([progress])
}

model User {
  id String @id @default(cuid())

  email               String    @unique
  name                String
  passwordHash        String
  role                UserRole  @default(BUSINESS_ADMIN)
  isActive            Boolean   @default(true)
  canCreateBusinesses Boolean   @default(false)
  firstLoginAt        DateTime?

  businessId                 String?
  business                   Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  professionalId             String?
  professional               Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  sessions                   UserSession[]
  managedBusinesses          Business[]    @relation("AccountAdminBusinesses")
  createdBusinesses          Business[]    @relation("CreatedBusinesses")
  canCreateAppointments      Boolean       @default(true)
  canEditAppointments        Boolean       @default(true)
  canCancelAppointments      Boolean       @default(true)
  canManageScheduleBlocks    Boolean       @default(true)
  staffProfile               String        @default("PROFESSIONAL")
  permissionPreset           String        @default("PROFESSIONAL_DEFAULT")
  agendaScope                String        @default("OWN")
  canForceAppointments       Boolean       @default(false)
  canViewCustomers           Boolean       @default(false)
  canCreateCustomers         Boolean       @default(false)
  canEditCustomers           Boolean       @default(false)
  canManageCustomerNotes     Boolean       @default(false)
  canManageCustomerMarketing Boolean       @default(false)
  canViewConversations       Boolean       @default(false)
  canReplyConversations      Boolean       @default(false)
  canManageDeposits          Boolean       @default(false)
  canViewOperationalReports  Boolean       @default(false)
  canViewFinancialAmounts    Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([professionalId])
  @@index([role])
}

model StaffAuditLog {
  id String @id @default(cuid())

  businessId String
  userId     String
  action     String
  entityType String
  entityId   String?
  method     String
  path       String
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
}

model UserSession {
  id String @id @default(cuid())

  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model BusinessWhatsAppConfig {
  id String @id @default(cuid())

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  connectionStatus   WhatsAppConnectionStatus @default(NOT_CONNECTED)
  mode               WhatsAppConnectionMode   @default(CLIENT_OWNED)
  wabaId             String?
  phoneNumberId      String?
  displayPhoneNumber String?
  metaAppId          String?
  accessToken        String?
  tokenExpiresAt     DateTime?
  connectedAt        DateTime?
  disconnectedAt     DateTime?
  lastError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessInstagramConfig {
  id String @id @default(cuid())

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  instagramAccountId String    @unique
  apiAccountId       String?   @unique
  username           String?
  accessToken        String?
  tokenExpiresAt     DateTime?
  enabled            Boolean   @default(true)
  connectedAt        DateTime?
  lastError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessPaymentSettings {
  id String @id @default(cuid())

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  transferEnabled    Boolean @default(false)
  alias              String?
  cbu                String?
  cvu                String?
  accountHolder      String?
  paymentLinkEnabled Boolean @default(false)
  paymentLink        String?
  instructions       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstagramLead {
  id String @id @default(cuid())

  businessId             String
  business               Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instagramUserId        String
  username               String?
  displayName            String?
  referralCode           String        @unique
  lastMessage            String?
  lastAutoReplyAt        DateTime?
  whatsappConversationId String?       @unique
  whatsappConversation   Conversation? @relation(fields: [whatsappConversationId], references: [id], onDelete: SetNull)
  whatsappLinkedAt       DateTime?

  messages InstagramMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, instagramUserId])
  @@index([businessId, updatedAt])
}

model WeexLead {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  phoneNormalized String
  campaign        String   @default("promocion-weex-agosto-2026")
  source          String   @default("directo")
  medium          String?
  campaignName    String?
  content         String?
  term            String?
  pageUrl         String?
  referrer        String?
  status          String   @default("NUEVO")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([campaign, createdAt])
}

model InstagramMessage {
  id String @id @default(cuid())

  leadId            String
  lead              InstagramLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  providerMessageId String?          @unique
  direction         MessageDirection
  body              String
  status            String?
  metadata          Json?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model BusinessFeatureSettings {
  id String @id @default(cuid())

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  botEnabled                     Boolean                   @default(true)
  aiEnabled                      Boolean                   @default(true)
  campaignsEnabled               Boolean                   @default(false)
  remindersEnabled               Boolean                   @default(false)
  realWhatsappEnabled            Boolean                   @default(false)
  bookingV2Enabled               Boolean                   @default(false)
  serviceCatalogDisplayMode      ServiceCatalogDisplayMode @default(ALL_SERVICES)
  bookingFlowOrder               BookingFlowOrder          @default(PROFESSIONAL_FIRST)
  conversationPauseAfterMinutes  Int                       @default(120)
  conversationExpireAfterMinutes Int                       @default(1440)
  assistantPersonality           Json?
  billingOwner                   BillingOwner              @default(CLIENT)
  campaignSendingLocked          Boolean                   @default(true)
  reminderSendingLocked          Boolean                   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessBotConfiguration {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  botKey             String
  name               String
  version            String
  mode               String  @default("OPTIONS_ONLY")
  status             String  @default("DRAFT")
  channel            String  @default("UNASSIGNED")
  routingMode        String  @default("EXCLUSIVE")
  phoneNumberId      String?
  displayPhoneNumber String?
  definition         Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, botKey])
  @@index([businessId, status])
  @@index([phoneNumberId, status])
}

model Professional {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  avatarUrl          String?
  isActive           Boolean   @default(true)
  acceptsBotBookings Boolean   @default(true)
  deactivatedAt      DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  appointments   Appointment[]
  workingHours   ProfessionalHours[]
  scheduleBlocks ScheduleBlock[]
  serviceLinks   ProfessionalService[]
  users          User[]

  createdAt DateTime @default(now())
}

model Service {
  id String @id @default(cuid())

  name                  String
  description           String?
  duration              Int
  customerDurationMin   Int?
  customerDurationMax   Int?
  category              String?
  price                 Int?
  priceMode             ServicePriceMode     @default(FIXED)
  imageUrl              String?
  isBookable            Boolean              @default(true)
  sortOrder             Int                  @default(0)
  bookingOrderPriority  Int                  @default(20)
  attentionMode         ServiceAttentionMode @default(DIRECT_BOOKING)
  requiresPhoto         Boolean              @default(false)
  estimateExplanation   String?
  estimateQuestion      String?
  estimateOptions       Json?
  estimateDisclaimer    String?
  estimateAllowsBooking Boolean              @default(true)
  validationEnabled     Boolean              @default(false)
  validationMessage     String?
  validationQuestion    String?
  depositMode           ServiceDepositMode   @default(NONE)
  depositValue          Int?
  depositHoldMinutes    Int                  @default(60)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  catalogCategoryId String?
  catalogCategory   ServiceCategory? @relation(fields: [catalogCategoryId], references: [id], onDelete: SetNull)

  parentServiceId      String?
  parentService        Service?                    @relation("ServiceVariants", fields: [parentServiceId], references: [id], onDelete: Restrict)
  variants             Service[]                   @relation("ServiceVariants")
  variantSelectionMode ServiceVariantSelectionMode @default(ONE_OF)

  appointments      Appointment[]
  appointmentItems  AppointmentServiceItem[]
  aliases           ServiceAlias[]
  professionalLinks ProfessionalService[]
  suggestedAddons   ServiceAddon[]           @relation("ServiceAddonSource")
  suggestedFor      ServiceAddon[]           @relation("ServiceAddonTarget")
  combinationRulesA ServiceCombinationRule[] @relation("ServiceCombinationA")
  combinationRulesB ServiceCombinationRule[] @relation("ServiceCombinationB")

  createdAt DateTime @default(now())

  @@index([businessId, catalogCategoryId, sortOrder])
  @@index([parentServiceId])
}

model ServiceCategory {
  id            String  @id @default(cuid())
  name          String
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)
  adviceEnabled Boolean @default(false)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  services Service[]
  aliases  ServiceCategoryAlias[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId, sortOrder])
}

model ServiceCategoryAlias {
  id             String @id @default(cuid())
  name           String
  normalizedName String

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([categoryId, normalizedName])
  @@index([normalizedName])
}

model ProfessionalService {
  id String @id @default(cuid())

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([professionalId, serviceId])
  @@index([serviceId])
}

model ServiceAlias {
  id   String @id @default(cuid())
  name String

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
}

model Customer {
  id String @id @default(cuid())

  businessId      String?
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  email           String?
  normalizedPhone String?

  appointments             Appointment[]
  notes                    CustomerNote[]
  marketingPreferences     CustomerMarketingPreference[]
  campaignDeliveries       CampaignDelivery[]
  manualCampaignRecipients CampaignManualRecipient[]
  campaignJobs             CampaignJob[]
  reminderDeliveries       ReminderDelivery[]
  postSaleDeliveries       PostSaleDelivery[]
  communicationRecipients  CommunicationRecipient[]
  weexLinks                WeexCustomerLink[]

  createdAt DateTime @default(now())

  @@unique([businessId, normalizedPhone])
  @@index([businessId, phone])
  @@index([businessId, createdAt])
  @@index([phone])
  @@index([email])
}

model WeexAccount {
  id String @id @default(cuid())

  googleSub                    String    @unique
  email                        String
  emailVerified                Boolean   @default(false)
  name                         String
  avatarUrl                    String?
  phone                        String?
  phoneVerifiedAt              DateTime?
  googleCalendarAccessToken    String?
  googleCalendarRefreshToken   String?
  googleCalendarTokenExpiresAt DateTime?
  googleCalendarScope          String?

  sessions      WeexAccountSession[]
  customerLinks WeexCustomerLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
}

model WeexAccountSession {
  id String @id @default(cuid())

  tokenHash String      @unique
  accountId String
  account   WeexAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

model WeexCustomerLink {
  id String @id @default(cuid())

  weexAccountId String
  weexAccount   WeexAccount @relation(fields: [weexAccountId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  phone    String
  linkedAt DateTime @default(now())

  @@unique([weexAccountId, customerId, businessId])
  @@index([weexAccountId, businessId])
  @@index([customerId])
  @@index([businessId])
  @@index([phone])
}

model CustomerNote {
  id         String   @id @default(cuid())
  body       String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

model Appointment {
  id String @id @default(cuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  startAt              DateTime
  origin               AppointmentOrigin @default(UNKNOWN)
  quotedPrice          Int?
  manualDepositPaid    Boolean           @default(false)
  manualDepositAmount  Int?
  totalDurationMinutes Int
  coordinationGroupId  String?

  status                  AppointmentStatus        @default(CONFIRMED)
  reminderDeliveries      ReminderDelivery[]
  convertedConversation   Conversation?            @relation("ConversationOpportunityAppointment")
  postSaleDeliveries      PostSaleDelivery[]
  bookingDeposit          BookingDeposit?
  serviceItems            AppointmentServiceItem[]
  googleCalendarEventId   String?
  googleCalendarAccountId String?

  createdAt DateTime @default(now())

  @@index([coordinationGroupId])
  @@index([professionalId, startAt])
}

model AppointmentServiceItem {
  appointmentId   String
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sortOrder       Int
  durationMinutes Int
  price           Int?

  @@id([appointmentId, serviceId])
  @@index([serviceId])
}

model ServiceAddon {
  sourceServiceId String
  sourceService   Service @relation("ServiceAddonSource", fields: [sourceServiceId], references: [id], onDelete: Cascade)
  addonServiceId  String
  addonService    Service @relation("ServiceAddonTarget", fields: [addonServiceId], references: [id], onDelete: Cascade)
  sortOrder       Int     @default(0)

  @@id([sourceServiceId, addonServiceId])
  @@index([addonServiceId])
}

model ServiceCombinationRule {
  id         String                   @id @default(cuid())
  businessId String
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceAId String
  serviceA   Service                  @relation("ServiceCombinationA", fields: [serviceAId], references: [id], onDelete: Cascade)
  serviceBId String
  serviceB   Service                  @relation("ServiceCombinationB", fields: [serviceBId], references: [id], onDelete: Cascade)
  policy     ServiceCombinationPolicy
  note       String?

  @@unique([businessId, serviceAId, serviceBId])
  @@index([serviceAId])
  @@index([serviceBId])
}

model BusinessHours {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  dayOfWeek Int

  startTime String
  endTime   String

  @@index([businessId, dayOfWeek])
}

model ProfessionalHours {
  id String @id @default(cuid())

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  dayOfWeek Int

  startTime String
  endTime   String

  createdAt DateTime @default(now())

  @@index([professionalId, dayOfWeek])
}

model Conversation {
  id String @id @default(cuid())

  phone      String
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  currentStep           ConversationStep @default(START)
  aiEnabled             Boolean          @default(true)
  misunderstandingCount Int              @default(0)

  selectedServiceId      String?
  selectedProfessionalId String?
  selectedDate           String?
  selectedTime           String?
  selectedCustomerName   String?
  lastAvailability       Json?
  bookingV2State         Json?
  supportBotKey          String?
  supportBotState        Json?

  lastMessage              String?
  humanHandoffAt           DateTime?
  humanHandoffResolvedAt   DateTime?
  photoQuoteAcknowledgedAt DateTime?
  archivedAt               DateTime?
  botProcessingToken       String?
  botProcessingUntil       DateTime?
  activeInteractivePromptToken String?

  opportunityStatus        ConversationOpportunityStatus @default(OPEN)
  opportunityOpenedAt      DateTime                      @default(now())
  opportunityConvertedAt   DateTime?
  opportunityClosedAt      DateTime?
  opportunityCloseReason   String?
  opportunityCloseNote     String?
  opportunityAppointmentId String?                       @unique
  opportunityAppointment   Appointment?                  @relation("ConversationOpportunityAppointment", fields: [opportunityAppointmentId], references: [id], onDelete: SetNull)

  messages           Message[]
  opportunityEvents  ConversationOpportunityEvent[]
  postSaleDeliveries PostSaleDelivery[]
  bookingDeposits    BookingDeposit[]
  instagramLead      InstagramLead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, phone])
  @@index([phone])
  @@index([businessId, archivedAt, updatedAt])
  @@index([currentStep, archivedAt, updatedAt])
  @@index([businessId, opportunityStatus, updatedAt])
}

model AiUsageEvent {
  id                String   @id @default(cuid())
  businessId        String?
  conversationId    String?
  appointmentId     String?
  source            String
  responseId        String   @unique
  model             String
  inputTokens       Int      @default(0)
  cachedInputTokens Int      @default(0)
  cacheWriteTokens  Int      @default(0)
  outputTokens      Int      @default(0)
  totalTokens       Int      @default(0)
  costNanoUsd       BigInt?
  pricingKey        String?
  createdAt         DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([conversationId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([source, createdAt])
}

model BookingDeposit {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  source           BookingDepositSource @default(WHATSAPP)
  mode             ServiceDepositMode
  configuredValue  Int
  baseAmount       Int?
  amount           Int
  status           BookingDepositStatus @default(PENDING_PROOF)
  expiresAt        DateTime
  proofMessageId   String?
  proofData        Bytes?
  proofMimeType    String?
  proofFilename    String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status, expiresAt])
  @@index([conversationId, createdAt])
}

model ConversationOpportunityEvent {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String
  reason         String?
  note           String?
  appointmentId  String?
  actorUserId    String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  phone     String
  direction MessageDirection
  body      String

  providerMessageId    String? @unique
  status               String?
  providerStatusCode   Int?
  providerErrorCode    String?
  providerErrorMessage String?
  metadata             Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
}

model ScheduleBlock {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])

  reason ScheduleBlockReason
  title  String?
  note   String?

  startAt DateTime
  endAt   DateTime

  createdAt DateTime @default(now())

  @@index([businessId, professionalId, startAt])
}

model Campaign {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name                    String
  type                    String                    @default("ONE_TIME")
  channel                 String                    @default("WHATSAPP")
  status                  String                    @default("DRAFT")
  segment                 String                    @default("ALL")
  segmentLabel            String                    @default("Todos los clientes")
  segmentDays             Int?
  priority                Int                       @default(2)
  maxAttempts             Int                       @default(2)
  retryIntervalDays       Int                       @default(30)
  cooldownDays            Int                       @default(30)
  respectCooldown         Boolean                   @default(true)
  stopOnBooking           Boolean                   @default(true)
  stopOnReply             Boolean                   @default(true)
  restartAfterVisit       Boolean                   @default(true)
  message                 String
  imageUrl                String?
  templateName            String?
  templateLanguage        String                    @default("es_AR")
  templateId              String?
  templateStatus          String                    @default("NOT_CREATED")
  templateRejectionReason String?
  templateLastSyncedAt    DateTime?
  whatsappTemplateId      String?
  whatsappTemplate        WhatsAppTemplate?         @relation(fields: [whatsappTemplateId], references: [id], onDelete: SetNull)
  scheduleMode            String                    @default("IMMEDIATE")
  scheduledAt             DateTime?
  budgetLimit             Int?
  deliveries              CampaignDelivery[]
  manualRecipients        CampaignManualRecipient[]
  runs                    CampaignRun[]
  jobs                    CampaignJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, status, updatedAt])
  @@index([whatsappTemplateId])
}

model WhatsAppTemplate {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  internalName        String
  metaName            String
  category            String               @default("MARKETING")
  language            String               @default("es_AR")
  body                String
  exampleJson         String?
  imageUrl            String?
  status              String               @default("DRAFT")
  metaId              String?
  rejectionReason     String?
  submittedAt         DateTime?
  lastSyncedAt        DateTime?
  campaigns           Campaign[]
  postSaleAutomations PostSaleAutomation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, metaName, language])
  @@index([businessId, status, updatedAt])
}

model ReminderAutomation {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name              String
  channel           String  @default("WHATSAPP")
  templateId        String?
  enabled           Boolean @default(false)
  mode              String  @default("PAUSED")
  sendBeforeMinutes Int     @default(1440)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deliveries ReminderDelivery[]

  @@index([businessId, enabled])
  @@index([businessId, mode])
  @@index([businessId, sendBeforeMinutes])
}

model ReminderDelivery {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  reminderAutomationId String
  reminderAutomation   ReminderAutomation @relation(fields: [reminderAutomationId], references: [id], onDelete: Cascade)

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status            String    @default("PENDING")
  mode              String    @default("WHATSAPP_API")
  messageSnapshot   String?
  providerMessageId String?
  attemptNumber     Int       @default(1)
  lastError         String?
  scheduledFor      DateTime
  openedAt          DateTime?
  sentAt            DateTime?
  skippedAt         DateTime?
  manualNote        String?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([reminderAutomationId, appointmentId])
  @@index([businessId, status, sentAt])
  @@index([businessId, status, scheduledFor])
  @@index([appointmentId])
  @@index([customerId, sentAt])
}

model PostSaleAutomation {
  id String @id @default(cuid())

  businessId         String            @unique
  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled            Boolean           @default(false)
  mode               String            @default("PAUSED")
  delayMinutes       Int               @default(120)
  responseWindowDays Int               @default(7)
  lowRatingThreshold Int               @default(2)
  templateId         String?
  template           WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  positiveResponse   String            @default("Gracias por tu calificación. Nos alegra que hayas tenido una buena experiencia.")
  neutralResponse    String            @default("Gracias por responder. Nos gustaría saber qué podríamos mejorar.")
  negativeResponse   String            @default("Lamentamos que tu experiencia no haya sido buena. El equipo va a contactarte por este chat.")
  reviewUrl          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  deliveries PostSaleDelivery[]

  @@index([enabled, businessId])
  @@index([mode, businessId])
  @@index([templateId])
}

model PostSaleDelivery {
  id String @id @default(cuid())

  businessId         String
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automationId       String?
  automation         PostSaleAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  appointmentId      String
  appointment        Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId     String?
  conversation       Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  visitDate          String
  status             String              @default("PENDING")
  mode               String              @default("WHATSAPP_API")
  messageSnapshot    String?
  providerMessageId  String?
  lastError          String?
  scheduledFor       DateTime
  openedAt           DateTime?
  sentAt             DateTime?
  skippedAt          DateTime?
  resolvedAt         DateTime?
  manualNote         String?
  responseExpiresAt  DateTime?
  respondedAt        DateTime?
  rating             Int?
  comment            String?
  commentRequestedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([businessId, customerId, visitDate])
  @@index([businessId, status, scheduledFor])
  @@index([conversationId, status, responseExpiresAt])
  @@index([appointmentId])
}

model CampaignManualRecipient {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, customerId])
  @@index([customerId])
}

model CustomerMarketingPreference {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status     String    @default("ACTIVE")
  source     String    @default("DEFAULT")
  optedInAt  DateTime?
  declinedAt DateTime?
  optedOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, customerId])
  @@index([businessId, status])
}

model CampaignDelivery {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status            String    @default("SENT")
  attemptNumber     Int       @default(1)
  providerMessageId String?
  sentAt            DateTime  @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  respondedAt       DateTime?
  bookedAt          DateTime?
  createdAt         DateTime  @default(now())

  @@index([businessId, customerId, sentAt])
  @@index([campaignId, customerId, sentAt])
}

model CampaignRun {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  mode                  String    @default("SIMULATION")
  status                String    @default("COMPLETED")
  candidateCount        Int       @default(0)
  eligibleCount         Int       @default(0)
  excludedCount         Int       @default(0)
  exclusionSummary      Json
  configurationSnapshot Json
  createdAt             DateTime  @default(now())
  completedAt           DateTime?

  jobs CampaignJob[]

  @@index([campaignId, createdAt])
  @@index([businessId, createdAt])
}

model CampaignJob {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  runId String
  run   CampaignRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status         String    @default("READY")
  attemptNumber  Int       @default(1)
  retryCount     Int       @default(0)
  maxRetries     Int       @default(3)
  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lockToken      String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([runId, customerId])
  @@index([status, nextAttemptAt])
  @@index([campaignId, customerId])
  @@index([businessId, status])
}

model CommunicationExecution {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  sourceType        String
  sourceId          String
  purpose           String
  mode              String
  status            String    @default("READY")
  initiatedByUserId String?
  candidateCount    Int       @default(0)
  eligibleCount     Int       @default(0)
  excludedCount     Int       @default(0)
  metadata          Json?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  recipients CommunicationRecipient[]

  @@index([businessId, sourceType, sourceId, createdAt])
  @@index([businessId, status, createdAt])
}

model CommunicationRecipient {
  id String @id @default(cuid())

  executionId String
  execution   CommunicationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  phoneSnapshot        String
  customerNameSnapshot String
  messageSnapshot      String
  status               String    @default("PENDING")
  sourceDeliveryId     String?   @unique
  providerMessageId    String?
  scheduledAt          DateTime?
  openedAt             DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  readAt               DateTime?
  respondedAt          DateTime?
  bookedAt             DateTime?
  skippedAt            DateTime?
  failedAt             DateTime?
  skipReason           String?
  failureReason        String?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events CommunicationEvent[]

  @@unique([executionId, customerId])
  @@index([businessId, customerId, sentAt])
  @@index([businessId, status, scheduledAt])
}

model CommunicationEvent {
  id String @id @default(cuid())

  recipientId String
  recipient   CommunicationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  actorType   String                 @default("SYSTEM")
  actorId     String?
  note        String?
  createdAt   DateTime               @default(now())

  @@index([recipientId, createdAt])
}
