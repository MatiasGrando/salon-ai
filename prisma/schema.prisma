// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Motor determinístico por opciones (bot-options) ─────────────────────────
// Tablas aditivas de etapa 1. Los vínculos con negocio/conversación usan
// columnas + índices para mantener esta extensión compatible con el runtime
// legado; el pointer de configuración sí impone pertenencia tenant-safe.

enum BotChannel {
  WHATSAPP
}

enum BotProviderEventType {
  MESSAGE
  STATUS
  UNSUPPORTED
}

enum BotProviderEventStatus {
  ADMITTED
  DUPLICATE
  UNMATCHED
  PROCESSED
  REJECTED
}

enum BotInboxStatus {
  ADMITTED
  CLAIMED
  SELECTED
  DUPLICATE
  CONFLICT
  STALE
  STALE_CUTOVER
  REJECTED
  PROCESSED
  FAILED
}

enum BotPromptMode {
  FUNCTIONAL
  NAVIGATION
  CONFLICT
}

enum BotPromptStatus {
  OPEN
  STABILIZING
  RESOLVED
  INVALIDATED
  EXPIRED
}

enum BotSessionStatus {
  ACTIVE
  HUMAN_QUEUED
  HUMAN_TAKEN
  CLOSED
}

/// Lifecycle durable de una consulta humana. F10.1 sólo materializa QUEUED y
/// CANCELLED; ownership, toma y resolución quedan deliberadamente inactivos.
enum BotHandoffStatus {
  QUEUED
  TAKEN
  CANCELLED
  RESOLVED
}

enum BotJobStatus {
  READY
  CLAIMED @map("LEASED")
  DONE
  RETRY
  POISON
}

enum BotOutboxStatus {
  PENDING
  CLAIMED
  SENDING
  UNKNOWN
  ACCEPTED
  DELIVERED
  READ
  RETRY
  FAILED
  POISON
  SKIPPED
}

enum BotDispatchKind {
  PROCESS
  SEND
  /// F11 legacy webhook work; deliberately independent of an active options configuration.
  LEGACY_PROCESS
}

enum BotDispatchStatus {
  CLAIMED
  SENDING
  UNKNOWN
  DONE
}

/// Journal durable de un inbound legacy. No es un Message ni una Conversation:
/// preserva el payload mínimo y el resultado antes de reconocer un reintento.
enum LegacyWhatsAppCutoverInboundStatus {
  PAUSED_ADMITTED
  LEGACY_DUPLICATE
  NORMAL_CLAIMED
  NORMAL_SENDING
  NORMAL_DONE
  NORMAL_UNKNOWN
  REPLAY_LEGACY_READY
  REPLAYING_LEGACY
  STALE_CUTOVER
  STALE_CUTOVER_DUPLICATE
  REPLAYED_LEGACY
}

model BotChannelDeployment {
  id                            String                    @id @default(cuid())
  businessId                    String
  channel                       BotChannel                @default(WHATSAPP)
  engineKey                     String                    @default("deterministic-options")
  activeConfigurationId         String?
  activeConfiguration           BusinessBotConfiguration? @relation("BotChannelDeploymentActiveConfiguration", fields: [businessId, activeConfigurationId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  previousConfigurationId       String?
  previousConfiguration         BusinessBotConfiguration? @relation("BotChannelDeploymentPreviousConfiguration", fields: [businessId, previousConfigurationId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  generation                    Int                       @default(0)
  activatedAt                   DateTime?
  activatedByUserId             String?
  claimsPausedAt                DateTime?
  dispatchFenceEpoch            Int                       @default(0)
  legacyDispatchCoverageVersion Int                       @default(0)
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt

  sessions BotSession[]     @relation("BotSessionDeployment")
  inbox    BotActionInbox[] @relation("BotInboxDeployment")
  jobs     BotJob[]         @relation("BotJobDeployment")

  @@unique([businessId, channel])
  @@unique([businessId, id])
}

model BotDeploymentAudit {
  id               String   @id @default(cuid())
  businessId       String
  action           String
  previousConfigId String?
  newConfigId      String?
  generation       Int
  actorUserId      String?
  detail           Json?
  createdAt        DateTime @default(now())

  @@index([businessId, createdAt])
}

model BotSession {
  id                    String               @id @default(cuid())
  businessId            String
  conversationId        String?
  deploymentId          String
  deployment            BotChannelDeployment @relation("BotSessionDeployment", fields: [businessId, deploymentId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  deploymentGeneration  Int
  channel               BotChannel           @default(WHATSAPP)
  engineVersion         String               @default("v1")
  businessTimezone      String
  stateSchemaVersion    Int                  @default(1)
  state                 Json
  revision              BigInt               @default(0)
  status                BotSessionStatus     @default(ACTIVE)
  handoffClaimsPausedAt DateTime?
  handoffFenceEpoch     Int                  @default(0)
  fenceToken            String?
  draftTouchedAt        DateTime?
  draftExpiresAt        DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  prompts        BotPrompt[]
  inbox          BotActionInbox[]   @relation("BotInboxSession")
  outbox         BotOutbox[]
  dispatchClaims BotDispatchClaim[]
  bookingVisits  BookingVisit[]
  handoffs       BotHandoff[]
  handoffAudits  BotHandoffAudit[]

  @@unique([businessId, id])
  @@unique([businessId, deploymentId, id])
  @@index([businessId, status])
  @@index([conversationId])
}

model BotHandoff {
  id             String           @id @default(cuid())
  businessId     String
  sessionId      String
  session        BotSession       @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  status         BotHandoffStatus @default(QUEUED)
  reason         String
  detail         String?
  context        Json?
  queuedAt       DateTime         @default(now())
  cancelledAt    DateTime?
  /// Reserved for F10.2+ ownership; F10.1 never writes these columns.
  ownerUserId    String?
  takenAt        DateTime?
  resolvedAt     DateTime?
  resumePolicy   String?
  /// F10.4 immutable TAKE baseline; absence deliberately fails RESUME closed.
  resumeSnapshot Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  audits BotHandoffAudit[]

  @@unique([businessId, id])
  @@index([businessId, sessionId, queuedAt])
  @@index([status, queuedAt])
  @@index([status, takenAt])
}

/// F10.2 ownership ledger. Application writes are append-only; the migration
/// revokes UPDATE/DELETE from the runtime role when that role is separated.
model BotHandoffAudit {
  id           String     @id @default(cuid())
  businessId   String
  sessionId    String
  handoffId    String
  handoff      BotHandoff @relation(fields: [businessId, handoffId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  session      BotSession @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  action       String
  actorUserId  String?
  operationKey String
  detail       Json?
  createdAt    DateTime   @default(now())

  @@unique([handoffId, operationKey, action])
  @@index([businessId, sessionId, createdAt])
  @@index([createdAt, action])
}

model BotPrompt {
  id              String          @id @default(cuid())
  sessionId       String
  session         BotSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  promptToken     String          @unique
  stateRevision   BigInt
  mode            BotPromptMode   @default(FUNCTIONAL)
  status          BotPromptStatus @default(OPEN)
  openedAt        DateTime        @default(now())
  firstActionAt   DateTime?
  lastActionAt    DateTime?
  settleAt        DateTime?
  absoluteAt      DateTime?
  resolvedAt      DateTime?
  outboxMessageId String?

  choices BotPromptChoice[]
  inbox   BotActionInbox[]  @relation("BotInboxPrompt")

  @@unique([sessionId, id])
  @@index([status, settleAt])
  @@index([sessionId, stateRevision])
}

model BotPromptChoice {
  id            String    @id @default(cuid())
  promptId      String
  prompt        BotPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  choiceToken   String
  actionType    String
  entityType    String?
  entityId      String?
  payload       Json?
  labelSnapshot String
  sortOrder     Int       @default(0)

  @@unique([promptId, choiceToken])
}

model BotProviderEvent {
  id                 String                 @id @default(cuid())
  provider           String                 @default("WHATSAPP")
  eventKey           String
  eventType          BotProviderEventType
  businessId         String
  phoneNumberId      String?
  providerMessageId  String?
  payload            Json?
  providerOccurredAt DateTime?
  admittedAt         DateTime               @default(now())
  status             BotProviderEventStatus @default(ADMITTED)
  traceId            String?

  inbox BotActionInbox[] @relation("BotInboxProviderEvent")

  @@unique([provider, eventKey])
  @@unique([businessId, id])
  @@index([providerMessageId])
  @@index([businessId, admittedAt])
}

model BotProviderEventShadow {
  id              String                @id @default(cuid())
  provider        String                @default("WHATSAPP")
  eventKey        String
  businessId      String?
  phoneNumberId   String?
  eventType       BotProviderEventType?
  payloadRedacted Json?
  observedAt      DateTime              @default(now())
  result          String
  traceId         String?

  @@unique([provider, eventKey])
  @@index([businessId, observedAt])
}

model BotActionInbox {
  id                   String               @id @default(cuid())
  businessId           String
  providerEventId      String
  providerEvent        BotProviderEvent     @relation("BotInboxProviderEvent", fields: [businessId, providerEventId], references: [businessId, id], onDelete: Cascade, onUpdate: Cascade)
  sessionId            String?
  session              BotSession?          @relation("BotInboxSession", fields: [businessId, deploymentId, sessionId], references: [businessId, deploymentId, id], onDelete: Cascade, onUpdate: Cascade)
  promptId             String?
  prompt               BotPrompt?           @relation("BotInboxPrompt", fields: [sessionId, promptId], references: [sessionId, id], onDelete: Cascade, onUpdate: Cascade)
  providerMessageId    String?
  choiceToken          String?
  actionType           String?
  deploymentId         String
  deployment           BotChannelDeployment @relation("BotInboxDeployment", fields: [businessId, deploymentId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  deploymentGeneration Int
  entityRef            Json?
  payload              Json?
  expectedRevision     BigInt?
  receivedAt           DateTime             @default(now())
  status               BotInboxStatus       @default(ADMITTED)
  claimToken           String?
  claimedUntil         DateTime?
  operationKey         String?
  error                String?

  @@index([promptId, status, receivedAt])
  @@index([businessId, providerEventId])
  @@index([status, claimedUntil])
  @@index([sessionId, receivedAt])
}

model BotJob {
  id                   String               @id @default(cuid())
  kind                 String
  aggregateId          String
  businessId           String
  deploymentId         String
  deployment           BotChannelDeployment @relation("BotJobDeployment", fields: [businessId, deploymentId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  deploymentGeneration Int
  expectedRevision     BigInt?
  availableAt          DateTime             @default(now())
  status               BotJobStatus         @default(READY)
  attempts             Int                  @default(0)
  maxAttempts          Int                  @default(5)
  claimToken           String?              @map("leaseToken")
  claimedUntil         DateTime?            @map("leasedUntil")
  lastError            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([kind, aggregateId])
  @@index([status, availableAt])
  @@index([status, claimedUntil])
  @@index([businessId, deploymentId, status])
}

model BotOutbox {
  id                String          @id @default(cuid())
  businessId        String
  sessionId         String
  session           BotSession      @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Cascade, onUpdate: Cascade)
  transitionId      String
  deliveryGroupId   String
  sequence          Int
  kind              String
  payload           Json
  idempotencyKey    String          @unique
  status            BotOutboxStatus @default(PENDING)
  dependsOnSequence Int?
  providerMessageId String?
  errorCode         String?
  attempts          Int             @default(0)
  maxAttempts       Int             @default(5)
  availableAt       DateTime        @default(now())
  claimToken        String?         @map("leaseToken")
  claimedUntil      DateTime?       @map("leasedUntil")
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  resolutions BotOutboxResolution[]

  @@unique([sessionId, deliveryGroupId, sequence])
  @@index([sessionId, sequence])
  @@index([deliveryGroupId, sequence])
  @@index([status, availableAt])
  @@index([status, claimedUntil])
}

model BotOutboxResolution {
  id        String    @id @default(cuid())
  outboxId  String
  outbox    BotOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  type      String
  actorId   String
  reason    String
  detail    Json?
  createdAt DateTime  @default(now())

  @@index([outboxId, createdAt])
}

model BotDispatchClaim {
  id                String            @id @default(cuid())
  businessId        String
  channel           BotChannel        @default(WHATSAPP)
  sessionId         String?
  session           BotSession?       @relation(fields: [businessId, sessionId], references: [businessId, id], onDelete: Cascade, onUpdate: Cascade)
  resourceId        String?
  engineKey         String
  generation        Int
  fenceEpoch        Int
  handoffFenceEpoch Int?
  kind              BotDispatchKind
  status            BotDispatchStatus @default(CLAIMED)
  claimToken        String            @unique
  claimedAt         DateTime          @default(now())
  claimedUntil      DateTime
  providerMessageId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([businessId, channel, kind, status])
  @@index([kind, resourceId, status])
  @@index([status, claimedUntil])
}

model LegacyWhatsAppCutoverInbound {
  id                   String                             @id @default(cuid())
  receiptKey           String                             @unique
  businessId           String
  business             Business                           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  deploymentId         String
  deploymentGeneration Int
  dispatchFenceEpoch   Int
  pausedAt             DateTime?
  providerMessageId    String
  fromPhone            String
  phoneNumberId        String?
  displayPhoneNumber   String?
  /// Proyección versionada mínima; nunca raw body, headers, firmas ni secretos.
  payload              Json
  status               LegacyWhatsAppCutoverInboundStatus @default(PAUSED_ADMITTED)
  claimToken           String?
  claimedUntil         DateTime?
  replayedAt           DateTime?
  staleAt              DateTime?
  providerEventId      String?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  @@unique([businessId, providerMessageId])
  @@index([businessId, deploymentId, deploymentGeneration, dispatchFenceEpoch, pausedAt, status, createdAt])
  @@index([status, claimedUntil])
}

model BotTransitionLog {
  id                   String   @id @default(cuid())
  businessId           String
  sessionId            String
  deploymentId         String
  deploymentGeneration Int
  revisionFrom         BigInt
  revisionTo           BigInt
  actionType           String
  outcome              String
  promptId             String?
  providerEventId      String?
  durationMs           Int?
  detail               Json?
  createdAt            DateTime @default(now())

  @@unique([sessionId, revisionTo])
  @@index([businessId, createdAt])
}

model BotOperation {
  id           String   @id @default(cuid())
  operationKey String   @unique
  type         String
  businessId   String
  sessionId    String
  status       String
  requestHash  String
  resultRef    String?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, status])
  @@index([sessionId, createdAt])
  @@index([status, type])
}

