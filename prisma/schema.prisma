  pipeline Pipeline      @relation(fields: [businessId, pipelineId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  lead     PipelineLead? @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  assignee User?         @relation("PipelineTaskAssignee", fields: [businessId, assigneeUserId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([businessId, id])
  @@index([businessId, pipelineId, archivedAt, status, position])
  @@index([businessId, assigneeUserId, archivedAt])
  @@index([businessId, leadId, archivedAt])
}

model LeadCaptureForm {
  id                    String                @id @default(cuid())
  businessId            String
  pipelineId            String
  initialStageId        String
  defaultAssigneeUserId String?
  publicSlug            String
  name                  String
  status                LeadCaptureFormStatus @default(DRAFT)
  rewardMode            LeadFormRewardMode    @default(NONE)
  schemaVersion         Int                   @default(1)
  version               Int                   @default(1)
  fields                Json                  @default("[]")
  successTitle          String?
  successMessage        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  business         Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pipeline         Pipeline                    @relation(fields: [businessId, pipelineId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  initialStage     PipelineStage               @relation(fields: [businessId, pipelineId, initialStageId], references: [businessId, pipelineId, id], onDelete: Restrict, onUpdate: Cascade)
  defaultAssignee  User?                       @relation("LeadCaptureFormDefaultAssignee", fields: [businessId, defaultAssigneeUserId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  submissions      FormSubmission[]
  rewards          FormReward[]
  rateLimitBuckets PublicFormRateLimitBucket[]

  @@unique([businessId, id])
  @@unique([businessId, publicSlug, version])
  @@index([businessId, status, publicSlug])
  @@index([businessId, pipelineId, initialStageId])
}

model FormSubmission {
  id                 String               @id @default(cuid())
  businessId         String
  formId             String
  leadId             String?
  idempotencyKey     String
  payloadFingerprint String
  status             FormSubmissionStatus @default(PENDING)
  rewardMode         LeadFormRewardMode   @default(NONE)
  schemaVersion      Int                  @default(1)
  answers            Json
  attribution        Json?
  contactName        String?
  normalizedEmail    String?
  normalizedPhone    String?
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  form         LeadCaptureForm @relation(fields: [businessId, formId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  lead         PipelineLead?   @relation(fields: [businessId, leadId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  rewardClaims RewardClaim[]

  @@unique([businessId, id])
  @@unique([businessId, formId, id])
  @@unique([businessId, formId, idempotencyKey])
  @@index([businessId, formId, status, createdAt])
  @@index([businessId, leadId])
}

model FormReward {
  id               String         @id @default(cuid())
  businessId       String
  formId           String
  name             String
  type             LeadRewardType
  version          Int            @default(1)
  enabled          Boolean        @default(true)
  payloadEncrypted String?
  objectPath       String?
  expiresInMinutes Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  form     LeadCaptureForm @relation(fields: [businessId, formId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  claims   RewardClaim[]

  @@unique([businessId, id])
  @@unique([businessId, formId, id])
  @@unique([businessId, formId, version])
  @@index([businessId, formId, enabled])
}

model RewardClaim {
  id            String    @id @default(cuid())
  businessId    String
  formId        String
  submissionId  String
  rewardId      String
  accessVersion Int       @default(1)
  expiresAt     DateTime?
  revokedAt     DateTime?
  firstAccessAt DateTime?
  accessCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submission FormSubmission @relation(fields: [businessId, formId, submissionId], references: [businessId, formId, id], onDelete: Restrict, onUpdate: Cascade)
  reward     FormReward     @relation(fields: [businessId, formId, rewardId], references: [businessId, formId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([businessId, id])
  @@unique([businessId, submissionId])
  @@index([businessId, rewardId, createdAt])
  @@index([expiresAt])
}

model PublicFormRateLimitBucket {
  id          String   @id @default(cuid())
  businessId  String
  formId      String
  scopeHash   String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  form     LeadCaptureForm @relation(fields: [businessId, formId], references: [businessId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([businessId, formId, scopeHash, windowStart])
  @@index([expiresAt])
}
