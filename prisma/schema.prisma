model BookingDeposit {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// El agregado F7/F8 que fue retenido. Las escrituras F8 lo completan; NULL
  /// se conserva sólo para depósitos legacy.
  visitId String?
  /// La FK compuesta impide vincular una seña de un tenant con una visita de otro.
  visit   BookingVisit? @relation(fields: [businessId, visitId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade, map: "BookingDeposit_visitId_fkey")

  source            BookingDepositSource         @default(WHATSAPP)
  mode              ServiceDepositMode
  configuredValue   Int
  baseAmount        Int?
  amount            Int
  status            BookingDepositStatus         @default(PENDING_PROOF)
  expiresAt         DateTime
  /// Momento efectivo, provisto por DB, en que F8.6 liberó la retención.
  expiredAt         DateTime?
  expirationReason  String?
  holdTtlMinutes    Int?
  holdTtlProvenance BookingDepositTtlProvenance?
  /// F8 closes its immutable financial snapshot only after all lines exist.
  snapshotSealedAt  DateTime?
  proofMessageId    String?
  proofData         Bytes?
  proofMimeType     String?
  proofFilename     String?
  reviewedAt        DateTime?
  reviewedByUserId  String?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines              BookingDepositLine[]
  expiryAudit        BookingDepositExpiryAudit?
  proofs             BookingDepositProof[]
  appointmentChanges AppointmentChangeHistory[] @relation("AppointmentChangeHistoryBookingDeposit")
  cashEntry          CashEntry?

  @@unique([businessId, id])
  @@unique([businessId, visitId])
  @@unique([appointmentId, id])
  @@index([businessId, status, expiresAt])
  @@index([conversationId, createdAt])
}

/// Append-only audit trail for a future F9 in-place appointment mutation.
/// `actor` is deliberately a required textual principal, not an actor hierarchy.
model AppointmentChangeHistory {
  id               String          @id @default(cuid())
  appointmentId    String
  appointment      Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  operationKey     String          @unique
  actor            String
  fromStartAt      DateTime
  toStartAt        DateTime
  bookingDepositId String?
  bookingDeposit   BookingDeposit? @relation("AppointmentChangeHistoryBookingDeposit", fields: [appointmentId, bookingDepositId], references: [appointmentId, id], onDelete: Restrict, onUpdate: Cascade)
  depositPreserved Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([appointmentId, createdAt])
}

/// Append-only reviewer decision trail. It intentionally has no byte columns;
/// retained proof bytes remain accessible only through BookingDepositProof.
model BookingDepositReviewAudit {
  id           String   @id
  businessId   String
