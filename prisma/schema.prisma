  createdAt    DateTime @default(now())

  @@index([businessId, depositId, createdAt])
}

/// Durable reviewer intent. F8.9 bridges approved static content into BotOutbox
/// atomically and marks the row ENQUEUED; no provider call occurs here.
model BookingDepositReviewOutbox {
  id         String   @id
  businessId String
  depositId  String
  auditId    String   @unique
  kind       String
  status     String
  createdAt  DateTime @default(now())

  @@index([businessId, status, createdAt])
}

/// Durable operational handoff for evidence received after an aggregate has
/// reached a terminal state. It never reopens the visit or appointment.
model BookingDepositLateProofHandoff {
  id         String   @id
  businessId String
  depositId  String
  proofId    String   @unique
  action     String
  createdAt  DateTime @default(now())

  @@index([businessId, depositId, createdAt], map: "BookingDepositLateProofHandoff_businessId_depositId_createdAt_i")
}

/// Evidencia F8 independiente del blob legacy de BookingDeposit. Cada fila es
/// append-only y conserva tanto el original como el derivado saneado; las
/// transiciones que elegirán la evidencia vigente quedan fuera de este slice.
model BookingDepositProof {
  id                  String                              @id @default(cuid())
  businessId          String
  business            Business                            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  depositId           String
  deposit             BookingDeposit                      @relation(fields: [businessId, depositId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  sequence            Int
  kind                BookingDepositProofKind
  validationStatus    BookingDepositProofValidationStatus @default(VALID)
  validatorVersion    String
  validatedAt         DateTime
  receivedAt          DateTime
  providerEventId     String?
  providerMessageId   String?
  providerMediaId     String?
  sourceData          Bytes?
  sourceMimeType      String
  sourceFilename      String
  sourceByteSize      Int
  sourceSha256        String
  derivedData         Bytes?
  derivedMimeType     String
  derivedByteSize     Int
  derivedSha256       String
  retentionEligibleAt DateTime
  /// DB-owned, irreversible retention transition. NULL means bytes remain.
  purgedAt            DateTime?
  purgeReason         String?
  createdAt           DateTime                            @default(now())

  @@unique([businessId, id])
  @@unique([businessId, depositId, sequence])
  @@unique([businessId, depositId, providerEventId])
  @@unique([businessId, depositId, providerMessageId])
  @@unique([businessId, depositId, providerMediaId])
  @@unique([businessId, depositId, sourceSha256])
  @@index([businessId, depositId, receivedAt])
  @@index([retentionEligibleAt])
  @@index([businessId, retentionEligibleAt])
}

/// Operation-level observability for an internal byte-only retention run. It
/// intentionally contains no customer, provider, filename, hash or byte data.
model BookingDepositProofPurgeOperation {
  id            String    @id
  operationKey  String    @unique
  scope         String
  businessId    String?
  reason        String
  requestHash   String
  status        String
  selectedCount Int       @default(0)
  purgedCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  events BookingDepositProofPurgeAudit[]

  @@index([businessId, createdAt])
}

/// Append-only record of each byte-only proof purge. IDs are operational
/// references, not PII; proof metadata remains in BookingDepositProof.
model BookingDepositProofPurgeAudit {
  id          String                            @id
  operationId String
  operation   BookingDepositProofPurgeOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessId  String
  depositId   String
  proofId     String
  reason      String
  purgedAt    DateTime
  createdAt   DateTime                          @default(now())

  @@unique([operationId, proofId])
  @@index([businessId, proofId, createdAt])
}

/// Evento append-only de la liberación automática. Conserva el deadline y las
/// identidades del agregado aunque las filas operativas cambien después.
model BookingDepositExpiryAudit {
  id            String         @id @default(cuid())
  businessId    String
  depositId     String         @unique
  deposit       BookingDeposit @relation(fields: [businessId, depositId], references: [businessId, id], onDelete: Restrict, onUpdate: Cascade)
  visitId       String
  appointmentId String
  jobId         String
  reason        String
  dueAt         DateTime
  expiredAt     DateTime
  createdAt     DateTime       @default(now())

  @@unique([businessId, depositId])
  @@index([businessId, expiredAt])
  @@index([businessId, visitId])
}

